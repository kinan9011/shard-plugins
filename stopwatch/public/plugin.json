{
  "id": "stopwatch",
  "name": "Stopwatch",
  "version": "1.0.1",
  "description": "Record laps and split times, and copy or export them as CSV. The stopwatch keeps running while you use other tools.",
  "category": "Time & Date",
  "keywords": [
    "stopwatch",
    "timer",
    "elapsed",
    "laps",
    "split"
  ],
  "icon": "lucide:Clock",
  "entry": "index.html",
  "runtime": "web",
  "permissions": [
    {
      "name": "clipboard:write",
      "reason": "Copy results",
      "optional": true
    },
    {
      "name": "files:save",
      "reason": "Save results to a file",
      "optional": true
    }
  ],
  "minAppVersion": "1.0.0",
  "license": "MIT",
  "source": "https://github.com/kinan9011/shard-plugins",
  "changelog": "CHANGELOG.md"
}
