{
  "id": "curl-to-code",
  "name": "cURL to Code",
  "version": "1.0.1",
  "description": "Convert a cURL command to fetch, Node, Python, Go, PHP, Rust, or HTTPie code.",
  "category": "Converters",
  "keywords": [
    "curl",
    "fetch",
    "python requests",
    "go",
    "php",
    "reqwest",
    "httpie",
    "http request"
  ],
  "icon": "lucide:Terminal",
  "entry": "index.html",
  "runtime": "web",
  "permissions": [
    {
      "name": "clipboard:write",
      "reason": "Copy results",
      "optional": true
    }
  ],
  "minAppVersion": "1.0.0",
  "license": "MIT",
  "source": "https://github.com/kinan9011/shard-plugins",
  "changelog": "CHANGELOG.md"
}
