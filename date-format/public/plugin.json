    "dayjs",
    "date-fns",
    "php date",
    "dotnet",
    "date format"
  ],
  "icon": "lucide:CalendarCog",
  "entry": "index.html",
  "runtime": "web",
  "permissions": [
    {
      "name": "clipboard:write",
      "reason": "Copy results",
      "optional": true
    }
  ],
  "minAppVersion": "3.0.0",
