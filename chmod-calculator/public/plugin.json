    "rwx",
    "umask",
    "setuid",
    "setgid",
    "sticky bit",
    "ls -l"
  ],
  "icon": "lucide:FileLock2",
  "entry": "index.html",
  "runtime": "web",
  "permissions": [
    {
      "name": "clipboard:write",
      "reason": "Copy results",
      "optional": true
    }
  ],
  "minAppVersion": "3.0.0",
