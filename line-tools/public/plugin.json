{
  "id": "line-tools",
  "name": "Line Tools",
  "version": "1.0.0",
  "description": "Filter, sort, reverse, dedupe, trim, and shuffle lines, and compare two lists. Split, join, wrap, replace, sum, or multiply lines in Transform mode.",
  "category": "Text Tools",
  "keywords": [
    "split",
    "join",
    "wrap",
    "replace",
    "sum",
    "product",
    "sort",
    "dedupe",
    "unique",
    "lines",
    "shuffle",
    "reverse",
    "filter",
    "grep",
    "compare lists",
    "set difference",
    "intersection"
  ],
  "icon": "lucide:ListOrdered",
  "entry": "index.html",
  "runtime": "web",
  "permissions": [
    {
      "name": "clipboard:write",
      "reason": "Copy results",
      "optional": true
    }
  ],
  "minAppVersion": "3.0.0",
  "license": "MIT",
  "source": "https://github.com/kinan9011/shard-plugins",
  "changelog": "CHANGELOG.md"
}
